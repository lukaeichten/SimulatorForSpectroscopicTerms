{
  "name": "simulator-web",
  "private": true,
  "version": "0.1.0",
  "description": "Static web frontend of the simulator for spectroscopic terms.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "wasm": "wasm-pack build ../crates/wasm --target web --release --no-pack",
    "wasm:dev": "wasm-pack build ../crates/wasm --target web --dev --no-pack",
    "predev": "npm run wasm:dev",
    "dev": "vite",
    "prebuild": "npm run wasm",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "npm run wasm:dev",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wasm-pack": "^0.15.0"
  }
}
