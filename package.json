{
  "name": "simulator-for-spectroscopic-terms",
  "private": true,
  "description": "Simulator for spectroscopic terms: web application and documentation.",
  "license": "MIT",
  "workspaces": [
    "web",
    "docs"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace web",
    "dev:docs": "npm run start --workspace docs",
    "build": "npm run build --workspace web && npm run build --workspace docs && node scripts/assemble-site.mjs",
    "preview": "npm run preview --workspace web -- --outDir ../dist",
    "test": "npm test --workspace web",
    "lint": "npm run lint --workspace web && npm run typecheck --workspace docs"
  },
  "allowScripts": {
    "wasm-pack@0.15.0": true,
    "core-js": false,
    "lefthook": true
  },
  "overrides": {
    "katex": "^0.19.0",
    "postcss-selector-parser": "^7.1.6",
    "serialize-javascript": "^7.1.2",
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "tinypool": "^2.2.0"
  },
  "devDependencies": {
    "lefthook": "^2.2.2"
  }
}
